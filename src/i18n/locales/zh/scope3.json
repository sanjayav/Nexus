  "calcs": {
    "scope3_cat01": {
      "name": "外购商品和服务",
      "shortName": "类别 1 外购商品",
      "description": "报告公司所购商品和服务在生产过程中产生的上游排放。",
      "methods": {
        "supplier_specific": {
          "name": "供应商特定法",
          "inputs": {
            "supplier_emissions": {
              "label": "供应商报告的 tCO2e"
            }
          }
        },
        "activity_based": {
          "name": "平均数据法（质量 × 排放因子）",
          "inputs": {
            "quantity": {
              "label": "采购量"
            },
            "material": {
              "label": "材料类型"
            },
            "region": {
              "label": "地区"
            }
          }
        },
        "spend_based": {
          "name": "基于支出法",
          "inputs": {
            "spend": {
              "label": "支出"
            },
            "sector": {
              "label": "行业部门"
            }
          }
        }
      }
    },
    "scope3_cat02": {
      "name": "资本货物",
      "shortName": "类别 2 资本货物",
      "description": "报告公司在报告期内购置的长期资本资产的「从摇篮到大门」排放。",
      "methods": {
        "activity_based": {
          "name": "资产数量 × 排放因子",
          "inputs": {
            "asset": {
              "label": "资产类型"
            },
            "quantity": {
              "label": "数量（视资产而定：台/m²/t）"
            }
          }
        },
        "spend_based": {
          "name": "基于支出法",
          "inputs": {
            "spend": {
              "label": "资本支出（CAPEX）"
            },
            "sector": {
              "label": "资产行业"
            }
          }
        }
      }
    },
    "scope3_cat03": {
      "name": "燃料和能源相关活动",
      "shortName": "类别 3 燃料与能源",
      "description": "范围一和范围二所消耗燃料的上游（从油井到油箱）排放，以及外购电力的输配电损耗。",
      "methods": {
        "wtt_fuel": {
          "name": "WTT——外购燃料",
          "inputs": {
            "fuel": {
              "label": "燃料类型"
            },
            "energy_kwh": {
              "label": "交付能源量"
            }
          }
        },
        "tnd_losses": {
          "name": "电网输配电损耗（电力）",
          "inputs": {
            "kwh_purchased": {
              "label": "外购电力"
            },
            "grid_ef": {
              "label": "电网排放因子"
            },
            "region": {
              "label": "地区"
            }
          }
        }
      }
    },
    "scope3_cat04": {
      "name": "上游运输和配送",
      "shortName": "类别 4 上游运输配送",
      "description": "由报告公司付费的、从一级供应商处购入产品的运输以及设施之间的运输。",
      "methods": {
        "distance_based": {
          "name": "基于距离法（运输方式 × 重量 × 距离）",
          "inputs": {
            "mode": {
              "label": "运输方式"
            },
            "weight_t": {
              "label": "运输重量"
            },
            "distance_km": {
              "label": "距离"
            }
          }
        },
        "fuel_based": {
          "name": "基于燃料法",
          "inputs": {
            "fuel_litres": {
              "label": "燃料消耗量"
            },
            "fuel_ef": {
              "label": "排放因子"
            }
          }
        },
        "spend_based": {
          "name": "基于支出法",
          "inputs": {
            "spend": {
              "label": "物流支出"
            }
          }
        }
      }
    },
    "scope3_cat05": {
      "name": "运营中产生的废弃物",
      "shortName": "类别 5 废弃物",
      "description": "报告公司运营中产生的废弃物的处置和处理。",
      "methods": {
        "waste_type_method": {
          "name": "废弃物类型 × 处理方式",
          "inputs": {
            "waste_type": {
              "label": "废弃物类别"
            },
            "treatment": {
              "label": "处理方式"
            },
            "tonnes": {
              "label": "质量"
            }
          }
        },
        "average_data": {
          "name": "平均数据法",
          "inputs": {
            "tonnes": {
              "label": "废弃物总量"
            },
            "avg_ef": {
              "label": "平均排放因子"
            }
          }
        }
      }
    },
    "scope3_cat06": {
      "name": "商务差旅",
      "shortName": "类别 6 商务差旅",
      "description": "员工因商务活动乘坐非报告公司拥有或运营的交通工具出行。",
      "methods": {
        "distance_based": {
          "name": "基于距离法（出行方式 × 人公里）",
          "inputs": {
            "mode": {
              "label": "出行方式"
            },
            "pax_km": {
              "label": "人公里"
            }
          }
        },
        "hotel_nights": {
          "name": "酒店住宿",
          "inputs": {
            "nights": {
              "label": "间夜数"
            },
            "region": {
              "label": "地区"
            }
          }
        },
        "spend_based": {
          "name": "基于支出法",
          "inputs": {
            "spend": {
              "label": "差旅支出"
            }
          }
        }
      }
    },
    "scope3_cat07": {
      "name": "员工通勤",
      "shortName": "类别 7 员工通勤",
      "description": "员工往返住所与工作地点之间的交通。",
      "methods": {
        "distance_based": {
          "name": "距离 × FTE × 工作日",
          "inputs": {
            "mode": {
              "label": "通勤方式"
            },
            "avg_one_way_km": {
              "label": "平均单程距离"
            },
            "fte": {
              "label": "采用该方式的 FTE 数"
            },
            "workdays": {
              "label": "年工作日数"
            }
          }
        },
        "survey_avg": {
          "name": "调查平均值（每 FTE 排放因子）",
          "inputs": {
            "fte": {
              "label": "FTE 总数"
            },
            "avg_ef_per_fte": {
              "label": "每 FTE 年均排放因子"
            }
          }
        }
      }
    },
    "scope3_cat08": {
      "name": "上游租赁资产",
      "shortName": "类别 8 上游租赁",
      "description": "报告公司租入、且尚未计入范围一或范围二的资产的运营。",
