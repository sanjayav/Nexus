          "name": "基于支出法",
          "inputs": {
            "spend": {
              "label": "配送支出"
            }
          }
        }
      }
    },
    "scope3_cat10": {
      "name": "售出产品的加工",
      "shortName": "类别 10 产品加工",
      "description": "下游制造商加工报告公司售出的中间产品所产生的排放。",
      "methods": {
        "mass_based": {
          "name": "吨数 × 加工排放因子",
