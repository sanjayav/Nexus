            },
            "factor": {
              "label": "行业 EEIO 因子"
            }
          }
        }
      }
    },
    "scope3_cat11": {
      "name": "售出产品的使用",
      "shortName": "类别 11 售出产品使用",
      "description": "报告公司售出的商品和服务在其寿命期内最终使用所产生的直接和间接排放。",
      "methods": {
        "direct_use_energy": {
          "name": "直接使用——耗能产品",
          "inputs": {
            "units_sold": {
              "label": "售出数量"
            },
            "lifetime_yr": {
              "label": "预期使用寿命"
            },
            "energy_per_yr_kwh": {
              "label": "单位产品年能耗"
            },
            "grid_ef": {
              "label": "排放因子"
            }
          }
        },
        "direct_use_fuel": {
          "name": "直接使用——耗燃料产品",
          "inputs": {
            "units_sold": {
              "label": "售出数量"
            },
            "lifetime_fuel_l": {
              "label": "单位产品寿命期燃料消耗"
            },
            "fuel_ef": {
              "label": "燃料排放因子"
            }
          }
        },
        "indirect_use": {
          "name": "间接使用（基于 LCA）",
          "inputs": {
            "units_sold": {
              "label": "售出数量"
            },
            "lca_kgco2e_per_unit": {
              "label": "单位产品 LCA 使用阶段排放因子"
            }
          }
        }
      }
    },
