  "registry": {
    "scope-1-fuel": {
      "title": "Scope 1 — Fuel combustion",
      "description": "Compute direct GHG emissions from stationary or mobile combustion. Emission = Activity × EF × GWP.",
      "inputs": {
        "fuel": {
          "label": "Fuel type",
          "hint": "Selects the emission factor",
          "options": {
            "natural-gas": {
              "label": "Natural gas",
              "note": "IPCC 2006 — 56.1 tCO2e/TJ"
            },
            "fuel-gas": {
              "label": "Fuel gas (refinery)",
              "note": "IPCC 2006 — 57.6 tCO2e/TJ"
            },
            "fuel-oil": {
              "label": "Fuel oil",
              "note": "IPCC 2006 — 77.4 tCO2e/TJ"
            },
            "diesel": {
              "label": "Diesel",
              "note": "IPCC 2006 — 74.1 tCO2e/TJ"
            },
            "lpg": {
              "label": "LPG",
              "note": "IPCC 2006 — 63.1 tCO2e/TJ"
            },
            "naphtha": {
              "label": "Naphtha",
              "note": "IPCC 2006 — 73.3 tCO2e/TJ"
            }
          }
        },
        "activity": {
          "label": "Activity data",
          "hint": "Energy content of fuel consumed"
        },
        "gwp": {
          "label": "GWP",
          "hint": "IPCC AR6 default 1 for CO2e factors"
        }
      }
    },
    "scope-2-electricity": {
      "title": "Scope 2 — Purchased electricity",
      "description": "Compute indirect emissions from purchased electricity. Emission = kWh × Grid EF.",
      "inputs": {
        "grid": {
          "label": "Grid / procurement method",
          "options": {
            "th-location": {
              "label": "Thailand — location-based",
              "note": "TGO 2024 — 0.487 kgCO2/kWh"
            },
            "th-market": {
              "label": "Thailand — market-based (residual)",
              "note": "TGO 2024 market residual mix"
            },
            "rec-backed": {
              "label": "REC-backed renewable",
              "note": "Zero emissions with valid I-REC"
            },
            "ppa-solar": {
              "label": "Corporate PPA — solar",
              "note": "Lifecycle EF after PPA"
            }
          }
        },
        "mwh": {
          "label": "Consumption",
          "hint": "Metered purchased electricity"
        }
      }
    },
    "ghg-intensity": {
      "title": "GHG intensity",
      "description": "(Scope 1 + Scope 2) ÷ Production volume.",
      "inputs": {
        "scope1": {
          "label": "Scope 1 emissions"
        },
        "scope2": {
          "label": "Scope 2 emissions"
        },
        "production": {
          "label": "Production volume"
        }
      }
    },
    "injury-rate": {
      "title": "Injury rate (per million manhours)",
      "description": "Standard H&S rate = (Cases × 1,000,000) ÷ Manhours worked.",
      "inputs": {
        "cases": {
          "label": "Recordable cases"
        },
        "manhours": {
          "label": "Manhours worked"
        }
      }
    },
    "workforce-rate": {
      "title": "Workforce rate",
      "description": "(Events ÷ Total employees) × 100.",
      "inputs": {
        "events": {
          "label": "Events (hires or leavers)"
        },
        "total": {
          "label": "Total employees"
        }
      }
    },
    "retention-rate": {
      "title": "Parental leave return rate",
      "description": "Employees still employed 12 months after return ÷ Employees returning × 100.",
      "inputs": {
        "retained": {
          "label": "Employees still employed (12 months)"
        },
        "returned": {
          "label": "Employees returned from leave"
        }
      }
    },
    "pay-gap": {
      "title": "Gender pay gap",
      "description": "(Average female ÷ Average male) × 100. < 100% = women paid less.",
      "inputs": {
        "female": {
          "label": "Average female pay"
        },
        "male": {
          "label": "Average male pay"
        }
      }
    },
    "ceo-pay-ratio": {
      "title": "CEO pay ratio",
      "description": "Total CEO compensation ÷ median (or mean) employee compensation.",
      "inputs": {
        "ceo": {
          "label": "Total CEO compensation"
        },
        "employee": {
          "label": "Median (or mean) employee compensation"
        }
      }
    },
    "diversity-pct": {
      "title": "Diversity percentage",
      "description": "(Segment count ÷ Total) × 100.",
      "inputs": {
        "segment": {
          "label": "Segment count (e.g. women)"
        },
        "total": {
          "label": "Total group"
        }
      }
    },
    "energy-intensity": {
      "title": "Energy intensity",
      "description": "Total energy consumed ÷ Production volume.",
      "inputs": {
        "energy": {
          "label": "Total energy consumed"
        },
        "production": {
          "label": "Production volume"
        }
      }
    },
    "emission-intensity": {
      "title": "Emission intensity",
      "description": "Pollutant mass ÷ Production volume.",
      "inputs": {
        "mass": {
          "label": "Pollutant mass"
        },
        "production": {
          "label": "Production volume"
        }
      }
    },
    "water-recycled-pct": {
      "title": "Recycled water share",
      "description": "(Water recycled ÷ Total water withdrawal) × 100.",
      "inputs": {
        "recycled": {
          "label": "Water recycled"
        },
        "withdrawn": {
          "label": "Total water withdrawal"
        }
      }
    },
    "water-intensity": {
      "title": "Water consumption intensity",
      "description": "Net fresh water ÷ Production volume.",
      "inputs": {
        "water": {
          "label": "Net fresh water consumption"
        },
        "production": {
          "label": "Production volume"
        }
      }
    },
    "hazardous-recycled-pct": {
      "title": "% hazardous waste recycled",
      "description": "(Hazardous diverted ÷ Hazardous generated) × 100.",
      "inputs": {
        "diverted": {
          "label": "Hazardous waste diverted"
        },
        "generated": {
          "label": "Hazardous waste generated"
        }
      }
    },
    "hc-roi": {
      "title": "Human Capital ROI",
      "description": "(Revenue − (Operating expenses − Employee expenses)) ÷ Employee expenses.",
      "inputs": {
        "revenue": {
          "label": "Total revenue"
        },
        "opex": {
          "label": "Total operating expenses"
        },
        "empex": {
          "label": "Total employee-related expense"
        }
      }
    }
  }
